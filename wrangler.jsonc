{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amirreza-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "127876de-05f3-439f-a072-c0a3e0d91e55","database_name": "amirreza-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1d6355de99a446a5aabd6bf9b829bdbe" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
